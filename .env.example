# The Hello World homepage needs no secrets; Veo uses the server-only settings below.
# Add future server-only variables here with placeholder values only.
# Real development values belong in .env.local, which is ignored.
# Production values belong in IBM Code Engine secrets, not source uploads.

# Server-only. Use a billed Google Cloud project with aiplatform.googleapis.com enabled.
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Keep stable across instances/restarts. Generate with: openssl rand -hex 32
VEO_JOB_SECRET=

# Local development: gcloud auth application-default login
# IBM: mount a credential/WIF configuration as a secret file, then set this path.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-credentials.json
