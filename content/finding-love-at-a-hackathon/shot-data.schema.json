{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Finding Love at a Hackathon — episode shot data 1.1",
  "description": "Content contract: ten eight-second shots, normal full soundtrack, only [name] focus word silently mouthed. No word-onset or synchronization fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "series_title",
    "episode_number",
    "episode_id",
    "episode_title",
    "source_script",
    "duration_seconds",
    "aspect_ratio",
    "audio_mode",
    "story_time",
    "hook",
    "incoming_cliffhanger_id",
    "incoming_payoff",
    "turn",
    "relationship_beat",
    "cliffhanger",
    "shots"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "series_title": {
      "const": "Finding Love at a Hackathon"
    },
    "episode_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "episode_id": {
      "type": "string",
      "pattern": "^E[0-9]{2}$"
    },
    "episode_title": {
      "type": "string",
      "minLength": 1
    },
    "source_script": {
      "type": "string",
      "minLength": 1
    },
    "duration_seconds": {
      "const": 80
    },
    "aspect_ratio": {
      "const": "9:16"
    },
    "audio_mode": {
      "const": "full_scene_audio_focus_word_silently_mouthed"
    },
    "story_time": {
      "type": "string",
      "minLength": 1
    },
    "hook": {
      "type": "string",
      "minLength": 1
    },
    "incoming_cliffhanger_id": {
      "type": "string",
      "pattern": "^(PILOT|E[0-9]{2}-C)$"
    },
    "incoming_payoff": {
      "type": "string",
      "minLength": 1
    },
    "turn": {
      "type": "string",
      "minLength": 1
    },
    "relationship_beat": {
      "type": "string",
      "minLength": 1
    },
    "cliffhanger": {
      "type": "object",
      "required": [
        "id",
        "event",
        "next_payoff"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^E[0-9]{2}-C$"
        },
        "event": {
          "type": "string",
          "minLength": 1
        },
        "next_payoff": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/shot"
      }
    }
  },
  "$defs": {
    "focus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "word",
        "meaning",
        "primary",
        "delivery"
      ],
      "properties": {
        "word": {
          "type": "string",
          "pattern": "^[a-z]+$"
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "primary": {
          "const": true
        },
        "delivery": {
          "const": "silently_mouthed_by_[name]"
        }
      }
    },
    "learner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speaker",
        "text",
        "performance_text",
        "labelled_text",
        "focus_delivery"
      ],
      "properties": {
        "speaker": {
          "const": "[name]"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "performance_text": {
          "type": "string",
          "minLength": 1
        },
        "labelled_text": {
          "type": "string",
          "pattern": "^\\[name\\]: "
        },
        "focus_delivery": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "voiced": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speaker",
        "text",
        "delivery"
      ],
      "properties": {
        "speaker": {
          "enum": [
            "Lucy",
            "Leo",
            "Jules"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "delivery": {
          "const": "voiced_normally"
        }
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "shot_number",
        "duration_seconds",
        "source_duration_seconds",
        "episode_start_seconds",
        "episode_end_seconds",
        "scene",
        "location_id",
        "camera",
        "beat",
        "visible_cast",
        "visible_action",
        "protagonist_visible_throughout",
        "focus_word",
        "learner_line",
        "dialogue",
        "sound_cues",
        "continuity",
        "edit_only_overlay",
        "video_prompt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^E[0-9]{2}-S[0-9]{2}$"
        },
        "shot_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "duration_seconds": {
          "const": 8
        },
        "source_duration_seconds": {
          "const": 8
        },
        "episode_start_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 72
        },
        "episode_end_seconds": {
          "type": "integer",
          "minimum": 8,
          "maximum": 80
        },
        "scene": {
          "type": "string",
          "minLength": 1
        },
        "location_id": {
          "enum": [
            "T7",
            "DESK",
            "ALCOVE",
            "REVIEW"
          ]
        },
        "camera": {
          "type": "string",
          "minLength": 1
        },
        "beat": {
          "type": "string",
          "minLength": 1
        },
        "visible_cast": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "[name]",
              "Lucy",
              "Leo",
              "Jules"
            ]
          },
          "contains": {
            "const": "[name]"
          }
        },
        "visible_action": {
          "type": "string",
          "minLength": 1
        },
        "protagonist_visible_throughout": {
          "const": true
        },
        "focus_word": {
          "$ref": "#/$defs/focus"
        },
        "learner_line": {
          "$ref": "#/$defs/learner"
        },
        "dialogue": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/learner"
              },
              {
                "$ref": "#/$defs/voiced"
              }
            ]
          }
        },
        "sound_cues": {
          "type": "string",
          "minLength": 1
        },
        "continuity": {
          "type": "object",
          "required": [
            "in",
            "out"
          ],
          "additionalProperties": false,
          "properties": {
            "in": {
              "type": "string",
              "minLength": 1
            },
            "out": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "edit_only_overlay": {
          "type": "string",
          "minLength": 1
        },
        "video_prompt": {
          "type": "string",
          "minLength": 500
        }
      }
    }
  }
}
